# Byte-compiled / cache
# NOTE: *.py[cod] is a character class -> it already covers .pyc / .pyo / .pyd,
#       so *.pyc and *.pyo are intentionally not listed as separate lines.
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging metadata
*.egg-info/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Local scratch
tests/_tmp/
*.tmp
*.log

# Office lock files (created when Word has a document open)
~$*.docx
~$*.xlsx
~$*.pptx

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Deliberately NOT ignored:
#   *.json  - tpl.json is a product artifact (docx_template.py extract output)
#   *.docx  - test fixtures and sample documents may be committed
